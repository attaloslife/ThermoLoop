(text "Open Inspect > Simulator. Run the analysis and select node voltages.\nModels live in spice/. See README.md for assumptions.\nThis is a reduced behavioral bench, not the production schematic." (at 25 105 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "4fada11c-33b6-5804-a4cc-208646ab1b41"))
